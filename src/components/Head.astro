---
import { siteConfig } from '../config';
import type { ImageMetadata } from 'astro';
import OpenGraphImage from '../assets/opengraph-image.png';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const { name, tagline } = siteConfig;

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	author?: string;
	pubDate?: Date;
}

const { 
	title, 
	description = tagline, 
	image = OpenGraphImage,
	type = 'website',
	author,
	pubDate,
} = Astro.props;

// Handle image URL - support both ImageMetadata and string paths
const imageUrl = typeof image === 'string' 
	? new URL(image, Astro.url)
	: new URL(image.src, Astro.url);

// Get image dimensions if available
const imageWidth = typeof image === 'object' && 'width' in image ? image.width : 1200;
const imageHeight = typeof image === 'object' && 'height' in image ? image.height : 630;

// Optimize title and description for SEO
const ogTitle = title.length < 50 ? `${title} | ${name}` : title;
const ogDescription = description.length > 160 
	? description.substring(0, 157) + '...'
	: description;
---

<title>{title} | {name}</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light only" />
<meta name="theme-color" content="#175704" />

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" sizes="64x64" type="image/png" href="/favicon-64.png" />
<link rel="icon" sizes="180x180" type="image/png" href="/favicon-180.png" />
<link rel="icon" sizes="192x192" type="image/png" href="/favicon-192.png" />
<link rel="icon" sizes="512x512" type="image/png" href="/favicon-512.png" />
<link rel="apple-touch-icon" type="image/png" href="/touch-icon.png" />
<link rel="canonical" href={canonicalUrl} />

<meta name="title" content={ogTitle} />
<meta name="description" content={ogDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={name} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={imageWidth.toString()} />
<meta property="og:image:height" content={imageHeight.toString()} />
<meta property="og:image:alt" content={title} />
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />
